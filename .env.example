# ============================================
# OpenClaw Product Research - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- AI Model ----
BAILIAN_API_KEY=your_bailian_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# ---- Amazon Data Source ----
# Option 1: Dedicated Amazon API (Helium 10 / Jungle Scout / 卖家精灵 etc.)
AMAZON_API_KEY=your_amazon_api_key_here
AMAZON_API_BASE_URL=https://api.example.com/amazon

# Option 2: Third-party data service (e.g., Taobaoapi2014)
# AMAZON_API_KEY=your_third_party_key
# AMAZON_API_BASE_URL=https://api.thirdparty.com/amazon

# ---- Google Trends ----
# Option 1: SERP API with Trends access
GOOGLE_TRENDS_KEY=your_google_trends_api_key_here
GOOGLE_TRENDS_API_BASE_URL=https://api.example.com/trends

# Option 2: Leave empty to use Tavily fallback
# GOOGLE_TRENDS_KEY=

# ---- TikTok Data ----
# Option 1: TikTok data API
TIKTOK_API_KEY=your_tiktok_api_key_here
TIKTOK_API_BASE_URL=https://api.example.com/tiktok

# Option 2: Leave empty to use Tavily fallback
# TIKTOK_API_KEY=

# ---- Tavily (Universal Fallback - HIGHLY RECOMMENDED) ----
# Get your key at https://tavily.com — free tier available
TAVILY_API_KEY=your_tavily_api_key_here

# ---- Feishu / Lark Integration ----
FEISHU_APP_ID=your_feishu_app_id
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_ALLOW_USER_IDS=user_id_1,user_id_2

# ---- OpenClaw Gateway ----
OPENCLAW_GATEWAY_TOKEN=your_secure_random_token_here

# ---- Optional: IP Proxy (for large-scale scraping) ----
# PROXY_URL=http://your-proxy:port
# PROXY_KEY=your_proxy_key
